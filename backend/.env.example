# Copy this file to backend/.env and fill in real values. backend/.env is
# git-ignored — never commit real credentials.
#
# Everything below is optional in the sense that the app boots without it
# (see app/core/config.py) — but individual features degrade to a clear
# "not configured" error rather than working, so fill in whatever your work
# touches.

# Postgres. Only chat-session persistence is DB-backed today (see CLAUDE.md).
# When running via `docker compose up`, docker-compose.yml overrides this to
# point at the `db` service — this value only matters running the backend
# directly on your host.
DATABASE_URL=postgresql+psycopg2://maris:oceanmind@localhost:5432/maris

# Where the frontend is served from (links/redirects only).
FRONTEND_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Copernicus Marine Service (https://marine.copernicus.eu/) — free account.
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# NASA Earthdata (https://earthdata.nasa.gov/) — free account, bearer token.
NASA_BEARER_TOKEN=

# Global Fishing Watch (https://globalfishingwatch.org/) — API token.
GFW_TOKEN=

# aisstream.io live AIS feed. Without it the vessel layer serves an empty
# collection rather than failing.
AISSTREAM_API_KEY=

# Tavily web search — the Ocean Assistant's web_research tool.
TAVILY_API_KEY=

# Sent as CrossRef's `mailto` param for the "polite pool" rate limit.
CROSSREF_MAILTO=

# HMAC key for signed confirm/unsubscribe tokens (any random string you
# generate yourself, e.g. `openssl rand -hex 32`) — not an external credential.
WATCH_TOKEN_SECRET=

# LLM insights provider (gemini | openai | ollama) — swap provider by
# changing these two lines only.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Feedback form email delivery (Gmail SMTP + app password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Set to true on a small development machine — skips the boot-time forecast
# grid rebuild (can peak ~3GB per variable). The scheduled job still runs.
FORECAST_GRID_REFRESH_ON_BOOT=true

LOG_LEVEL=INFO
